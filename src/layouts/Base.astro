---
import '../styles/style.css';
const { title, description = '', current = '', image = '', type = 'website' } = Astro.props;
// Absolute URLs for link previews and canonical. Astro.site comes from astro.config.
const site = Astro.site ?? new URL('https://portfolio.calipercrayon.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image || '/img/brand/mark.png', site).href;
const fullTitle = `${title} · Caliper & Crayon`;
// Footer links go to the original site (www.calipercrayon.com) until these sections exist here.
const old = 'https://www.calipercrayon.com/about';
const sections = {
  caliper: [['Origin Labs', `${old}/caliper/origin`], ['Autodesk Ember', `${old}/caliper/autodesk`], ['EngineerGuy', `${old}/caliper/engineerguy`], ['University of Illinois', `${old}/caliper/uiuc`], ['Arizona State', `${old}/caliper/asu`]],
  crayon: [['Photography', `${old}/crayon/photography`], ['Design', `${old}/crayon/design`], ['Performance', `${old}/crayon/performance`]],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="Caliper & Crayon">
<meta property="og:title" content={fullTitle}>
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}>
<meta name="twitter:title" content={fullTitle}>
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage}>
<link rel="sitemap" href="/sitemap-index.xml">
<slot name="head" />
<link rel="icon" href="/img/brand/mark.svg" type="image/svg+xml">
<link rel="icon" href="/img/brand/mark.png" sizes="256x256">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Mono:wght@400;500&display=swap">
</head>
<body>
<nav class="nav" aria-label="Site">
  <div class="wrap">
    <a class="wm" href="/"><img src="/img/brand/mark.svg" alt="">Caliper &amp; Crayon</a>
    <ul>
      <li><a href="https://www.calipercrayon.com/about">About</a></li>
      <li><a href="/" aria-current={current === 'portfolio' ? 'page' : undefined}>Portfolio</a></li>
      <li><a href="https://www.calipercrayon.com/services">Services</a></li>
      <li><a href="https://www.calipercrayon.com/culture">Culture</a></li>
      <li><a href="https://www.calipercrayon.com/contact">Contact</a></li>
    </ul>
  </div>
</nav>
<main><slot /></main>
<footer class="footer">
  <div class="wrap">
    <div class="col"><img src="/img/brand/mark.svg" alt=""><span class="mono" style="margin-top:8px">Caliper &amp; Crayon</span></div>
    <div class="col"><span class="mono">Caliper</span>{sections.caliper.map(([label, url]) => <a href={url}>{label}</a>)}</div>
    <div class="col"><span class="mono">Crayon</span>{sections.crayon.map(([label, url]) => <a href={url}>{label}</a>)}</div>
    <div class="col"><span class="mono">Contact</span><span>stephenjameskranz @ gmail . com</span><a href="/docs/sj-kranz-cv.pdf">Curriculum vitae (PDF)</a></div>
  </div>
</footer>
</body>
</html>
