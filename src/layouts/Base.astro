---
import '../styles/style.css';
const { title, description = '', current = '' } = Astro.props;
// Footer links go to the original site (www.calipercrayon.com) until these sections exist here.
const old = 'https://www.calipercrayon.com/about';
const sections = {
  caliper: [['Origin Labs', `${old}/caliper/origin`], ['Autodesk Ember', `${old}/caliper/autodesk`], ['EngineerGuy', `${old}/caliper/engineerguy`], ['University of Illinois', `${old}/caliper/uiuc`], ['Arizona State', `${old}/caliper/asu`]],
  crayon: [['Photography', `${old}/crayon/photography`], ['Design', `${old}/crayon/design`], ['Performance', `${old}/crayon/performance`]],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title} · Caliper &amp; Crayon</title>
{description && <meta name="description" content={description} />}
<link rel="icon" href="/img/brand/mark.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Mono:wght@400;500&display=swap">
</head>
<body>
<nav class="nav" aria-label="Site">
  <div class="wrap">
    <a class="wm" href="/"><img src="/img/brand/mark.png" alt="">Caliper &amp; Crayon</a>
    <ul>
      <li><a href="/work/" aria-current={current === 'work' ? 'page' : undefined}>Work</a></li>
      <li><a href="https://www.calipercrayon.com/about">About</a></li>
      <li><a href="https://www.calipercrayon.com/services">Services</a></li>
      <li><a href="https://www.calipercrayon.com/contact">Contact</a></li>
    </ul>
  </div>
</nav>
<main><slot /></main>
<footer class="footer">
  <div class="wrap">
    <div class="col"><img src="/img/brand/mark.png" alt=""><span class="mono" style="margin-top:8px">Caliper &amp; Crayon</span></div>
    <div class="col"><span class="mono">Caliper</span>{sections.caliper.map(([label, url]) => <a href={url}>{label}</a>)}</div>
    <div class="col"><span class="mono">Crayon</span>{sections.crayon.map(([label, url]) => <a href={url}>{label}</a>)}</div>
    <div class="col"><span class="mono">Contact</span><span>stephenjameskranz@gmail.com</span><a href="/docs/sj-kranz-cv.pdf">Curriculum vitae (PDF)</a></div>
  </div>
</footer>
</body>
</html>
