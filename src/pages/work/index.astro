---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const order = ['design', 'photography', 'video', 'software', 'fabrication', 'process', 'research'];
const names = { design: 'Design', photography: 'Photography', video: 'Video', software: 'Software', fabrication: 'Fabrication', process: 'Process & procedures', research: 'Research' };
const groups = order.map((s) => ({ key: s, name: names[s], items: projects.filter((p) => p.data.section === s) })).filter((g) => g.items.length);
---
<Base title="Work" current="work">
  <div class="wrap">
    <header class="project-head" style="align-items:end">
      <h1 class="h1">Work</h1>
      <p class="lede">Technical and creative projects, by section. Crayon is the hand-made side, caliper the measured side.</p>
    </header>
    {groups.map((g) => (
      <section class="group" id={g.key}>
        <div class="group-head"><h2 class="h2">{g.name}</h2><span class="mono">{g.items.length} {g.items.length === 1 ? 'project' : 'projects'}</span></div>
        <div class="grid">
          {g.items.map((p) => (
            <a class="card" href={`/work/${p.id}/`}>
              <div class="img">{p.data.hero[0] && <img src={p.data.hero[0].image} alt={p.data.hero[0].alt} loading="lazy" />}</div>
              <div class="body">
                <h3 class="h3">{p.data.title}</h3>
                {p.data.summary && <p class="sum">{p.data.summary}</p>}
                <div class="tags"><span class={`tag ${p.data.side}`}>{p.data.side}</span>{p.data.year && <span class="mono">{p.data.year}</span>}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
