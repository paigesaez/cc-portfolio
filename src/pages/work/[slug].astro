---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Click-to-enlarge lightbox. Trial: on for these pages only; widen to all once it's approved.
const zoom = ['origin-flag'].includes(project.id);

// Photography pages: read each sheet image's aspect ratio so paired photos (one vertical, one horizontal) share a height.
import sharp from 'sharp';
const ratio: Record<string, number> = {};
if (d.section === 'photography') {
  for (const s of d.sheets) for (const im of s.images) {
    try { const m = await sharp('public' + im.image).metadata(); if (m.width && m.height) ratio[im.image] = m.width / m.height; } catch {}
  }
}

// Previous / next within the same section, by sort order then title.
const all = (await getCollection('projects'))
  .filter((p) => p.data.section === d.section)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const i = all.findIndex((p) => p.id === project.id);
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];
const sectionName = { design: 'Graphic design', illustration: 'Scientific illustration', photography: 'Photography', video: 'Video', software: 'Software', fabrication: 'Fabrication', process: 'Process & procedures', research: 'Research' }[d.section];
---
<Base title={d.title} description={d.summary} current="portfolio" image={d.hero[0]?.image} type="article">
  <div class="wrap">
    <header class="project-head">
      <div>
        <div class="tags">
          <span class={`tag ${d.side}`}>{d.side}</span>
          <a class="tag" href={`/#${d.section}`}>{sectionName}</a>
          {d.tags.map((t) => <span class="tag">{t}</span>)}
          {d.year && <span class="tag" style="border:0;padding-left:0">{d.year}</span>}
        </div>
        <h1 class="h1">{d.title}</h1>
      </div>
      {d.summary && <p class="lede">{d.summary}</p>}
    </header>
  </div>

  {d.hero.length > 0 && (
    <div class="wrap">
      <div class={`plinth ${d.hero.length > 1 ? 'pair' : 'single'}`}>
        {d.hero.map((h) => h.link ? <a class="img-link" href={h.link} rel="noopener"><img src={h.image} alt={h.alt} /></a> : <img src={h.image} alt={h.alt} data-zoom={zoom ? '' : undefined} />)}
      </div>
    </div>
  )}

  <div class="wrap">
    <div class="project">
      <aside class="metablock" aria-label="Project details">
        <dl>
          {d.role && <div><dt>My role</dt><dd class="roles">{d.role}</dd></div>}
          {d.collaborators && <div><dt>With</dt><dd>{d.collaborators}</dd></div>}
          {d.year && <div><dt>Year</dt><dd>{d.year}</dd></div>}
          {d.place && <div><dt>Place</dt><dd>{d.place}</dd></div>}
          {d.format && <div><dt>Format</dt><dd>{d.format}</dd></div>}
          {d.links.length > 0 && <div><dt>Links</dt><dd class="links">{d.links.map((l) => <a href={l.url} rel="noopener">{l.label}</a>)}</dd></div>}
        </dl>
      </aside>
      <article class="prose">
        <Content />
      </article>
    </div>
  </div>

  {d.sheets.length > 0 && (
    <div class={`wrap ${d.section === 'photography' ? 'photo' : ''}`}>
      {d.sheets.map((s) => (
        <section class="sheet">
          <div class={`plinth ${s.images.length > 1 ? 'pair' : ''}`}>
            {s.images.map((im) => im.link ? <a class="img-link" href={im.link} rel="noopener"><img src={im.image} alt={im.alt} /></a> : <img src={im.image} alt={im.alt} data-zoom={zoom ? '' : undefined} style={ratio[im.image] ? `--r: ${ratio[im.image]}` : undefined} />)}
          </div>
          {(s.label || s.caption) && <div class="cap"><span class="mono">{s.label}</span><p>{s.caption}</p></div>}
        </section>
      ))}
    </div>
  )}

  <div class="wrap">
    {d.docs.length > 0 && (
      <div class="docs">
        {d.docs.map((doc) => (
          <a class="doc" href={doc.url} rel="noopener"><span class="ic" data-kind={doc.kind}></span><span><b>{doc.title}</b><span>{doc.detail}</span></span></a>
        ))}
      </div>
    )}
    {import.meta.env.DEV && d.todo.length > 0 && (
      <div class="todo" aria-label="To finish this page">
        <div class="mono">To finish this page</div>
        <ul>{d.todo.map((t) => <li>{t}</li>)}</ul>
      </div>
    )}
    {all.length > 1 && (
      <nav class="prevnext" aria-label="More work">
        <a href={`/work/${prev.id}/`}><span class="mono">Previous</span><span class="h3">{prev.data.title}</span></a>
        <a href={`/work/${next.id}/`}><span class="mono">Next</span><span class="h3">{next.data.title}</span></a>
      </nav>
    )}
  </div>
  {zoom && (
    <dialog class="lightbox" aria-label="Enlarged image">
      <img alt="" />
      <button class="lb-close" type="button" aria-label="Close">×</button>
      <button class="lb-prev" type="button" aria-label="Previous image">‹</button>
      <button class="lb-next" type="button" aria-label="Next image">›</button>
    </dialog>
  )}
  <script>
    // Lightbox: images marked data-zoom open full screen when the stored file is meaningfully larger than how it's shown.
    const box = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (box) {
      const big = box.querySelector('img')!;
      const all = [...document.querySelectorAll<HTMLImageElement>('img[data-zoom]')];
      let list: HTMLImageElement[] = [];
      let i = 0;
      const worth = (im: HTMLImageElement) => im.naturalWidth > im.clientWidth * 1.25 || im.naturalHeight > im.clientHeight * 1.25;
      const mark = (im: HTMLImageElement) => {
        const ok = worth(im);
        im.classList.toggle('can-zoom', ok);
        if (ok) { im.tabIndex = 0; im.setAttribute('role', 'button'); im.setAttribute('aria-label', `Enlarge: ${im.alt}`); }
        else { im.removeAttribute('tabindex'); im.removeAttribute('role'); im.removeAttribute('aria-label'); }
      };
      const refresh = () => all.forEach((im) => (im.complete ? mark(im) : im.addEventListener('load', () => mark(im), { once: true })));
      refresh();
      addEventListener('resize', refresh);
      const show = (n: number) => {
        i = (n + list.length) % list.length;
        big.src = list[i].src; big.alt = list[i].alt;
        box.classList.toggle('solo', list.length < 2);
      };
      const open = (im: HTMLImageElement) => { list = all.filter((x) => x.classList.contains('can-zoom')); show(list.indexOf(im)); box.showModal(); };
      all.forEach((im) => {
        im.addEventListener('click', () => im.classList.contains('can-zoom') && open(im));
        im.addEventListener('keydown', (e) => { if ((e.key === 'Enter' || e.key === ' ') && im.classList.contains('can-zoom')) { e.preventDefault(); open(im); } });
      });
      box.querySelector('.lb-close')!.addEventListener('click', () => box.close());
      box.querySelector('.lb-prev')!.addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
      box.querySelector('.lb-next')!.addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
      box.addEventListener('click', (e) => { if (e.target === box || e.target === big) box.close(); });
      box.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
      let x0 = 0, y0 = 0;
      box.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
      box.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(i + (dx < 0 ? 1 : -1));
        else if (dy > 80) box.close();
      });
    }
  </script>
</Base>
