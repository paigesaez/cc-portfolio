---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
// Every project, grouped by its Section field (set per project in the editor), in this order.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const order = ['design', 'illustration', 'video', 'photography', 'software', 'fabrication', 'process', 'research'];
const names = { design: 'Design', illustration: 'Scientific illustration', video: 'Video', photography: 'Photography', software: 'Software', fabrication: 'Fabrication', process: 'Process & procedures', research: 'Research' };
const groups = order.map((s) => ({ key: s, name: names[s], items: projects.filter((p) => p.data.section === s) })).filter((g) => g.items.length);
---
<Base title="Portfolio" current="portfolio">
  <div class="wrap">
    <header class="project-head" style="padding-block:104px 40px">
      <div>
        <div class="mono" style="margin-bottom:24px">Stephen James Kranz · Berkeley, California</div>
        <h1 class="display">Caliper <span style="color:var(--crayon);font-weight:400">&amp;</span> Crayon</h1>
      </div>
      <p class="lede">Technical and creative storytelling. Video, photography, illustration, books and process design for engineering teams.</p>
    </header>
    {groups.map((g) => (
      <section class="group" id={g.key}>
        <div class="group-head"><h2 class="h2">{g.name}</h2><span class="mono">{g.items.length} {g.items.length === 1 ? 'project' : 'projects'}</span></div>
        <div class="grid">
          {g.items.map((p) => (
            <a class="card" href={`/work/${p.id}/`}>
              <div class="img">{p.data.hero[0] && <img src={p.data.hero[0].image} alt={p.data.hero[0].alt} loading="lazy" />}</div>
              <div class="body">
                <h3 class="h3">{p.data.title}</h3>
                {p.data.summary && <p class="sum">{p.data.summary}</p>}
                <div class="tags"><span class={`tag ${p.data.side}`}>{p.data.side}</span>{p.data.year && <span class="mono">{p.data.year}</span>}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
