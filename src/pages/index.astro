---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
// Every project, grouped by its Section field (set per project in the editor), in this order.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const order = ['design', 'illustration', 'video', 'photography', 'software', 'fabrication', 'process', 'research'];
const names = { design: 'Graphic design', illustration: 'Scientific illustration', video: 'Video', photography: 'Photography', software: 'Software', fabrication: 'Fabrication', process: 'Process & procedures', research: 'Research' };
const groups = order.map((s) => ({ key: s, name: names[s], items: projects.filter((p) => p.data.section === s) })).filter((g) => g.items.length);
---
<Base title="Graphic design portfolio" description="Stephen James Kranz, scientist and designer: book and editorial design, typography, scientific illustration and motion graphics." current="portfolio">
  <div class="wrap">
    <header class="project-head" style="padding-block:104px 40px">
      <div>
        <div class="mono" style="margin-bottom:24px">Stephen James Kranz · Berkeley, California</div>
        <h1 class="display">Caliper <span style="color:var(--crayon);font-weight:400">&amp;</span> Crayon</h1>
      </div>
      <p class="lede">Scientist and designer. Book and editorial design, typography, scientific illustration and motion graphics, grounded in a materials science degree.</p>
    </header>
    {groups.map((g) => (
      <section class="group" id={g.key}>
        <div class="group-head"><h2 class="h2">{g.name}</h2><span class="mono">{g.items.length} {g.items.length === 1 ? 'project' : 'projects'}</span></div>
        <div class="grid">
          {g.items.map((p) => (
            <a class="card" href={`/work/${p.id}/`}>
              {(() => {
                const t = { fit: 'whole', focus: 'center', zoom: '1', image: null, ...(p.data.thumb || {}) }; const src = t.image || p.data.hero[0]?.image; const alt = t.image ? p.data.title : (p.data.hero[0]?.alt || p.data.title);
                const zoom = Number(t.zoom) || 1; const style = `object-position: ${t.focus}; transform-origin: ${t.focus};${zoom !== 1 ? ` --zoom: ${zoom};` : ''}`;
                return <div class={`img ${t.fit}`}>{src && <img src={src} alt={alt} loading="lazy" style={style} />}</div>;
              })()}
              <div class="body">
                <h3 class="h3">{p.data.title}</h3>
                {p.data.summary && <p class="sum">{p.data.summary}</p>}
                {p.data.year && <div class="tags"><span class="mono">{p.data.year}</span></div>}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
