---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const featured = (await getCollection('projects')).filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---
<Base title="Home">
  <div class="wrap">
    <header class="project-head" style="padding-block:104px 40px">
      <div>
        <div class="mono" style="margin-bottom:24px">Stephen James Kranz · Oakland, California</div>
        <h1 class="display">Caliper <span style="color:var(--crayon);font-weight:400">&amp;</span> Crayon</h1>
      </div>
      <p class="lede">Technical and creative storytelling. Video, photography, illustration, books and process design for engineering teams.</p>
    </header>
    {featured.length > 0 && (
      <section class="group">
        <div class="group-head"><h2 class="h2">Selected work</h2><a class="mono" href="/work/">All work</a></div>
        <div class="grid">
          {featured.map((p) => (
            <a class="card" href={`/work/${p.id}/`}>
              <div class="img">{p.data.hero[0] && <img src={p.data.hero[0].image} alt={p.data.hero[0].alt} />}</div>
              <div class="body"><h3 class="h3">{p.data.title}</h3>{p.data.summary && <p class="sum">{p.data.summary}</p>}</div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
